NODE_ENV=development
PORT=3000

WHATSAPP_AUTH_PATH=./data/baileys-auth
AUTO_RECONNECT=true

RECONNECT_INITIAL_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000

API_KEY=replace_with_a_strong_random_secret

LOG_LEVEL=info

SHUTDOWN_TIMEOUT_MS=10000

MAX_RECIPIENTS_PER_REQUEST=10
MAX_MESSAGE_LENGTH=4000
SEND_DELAY_MS=1500
SEND_TIMEOUT_MS=30000
MAX_SEND_REQUESTS_PER_MINUTE=10
MAX_OUTBOUND_MESSAGES_PER_HOUR=30
ALLOW_ALL_RECIPIENTS=false
ALLOWED_RECIPIENTS=
