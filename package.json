{
  "name": "whatsapp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp gateway for session management and outbound text messaging.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qr": "node scripts/show-qr.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.13.15",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "qrcode": "^1.5.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
